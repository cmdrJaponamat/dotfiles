rewrite_file() {
  local file="$1"
  local expr="$2"
  [[ -f "${file}" ]] || return 0
  perl -0pi -e "${expr}" "${file}"
}

apply_profile() {
  local resolved="$1"
  set_values "${resolved}"

  rewrite_file "${config_home}/alacritty/alacritty.toml" "s/^size = .*\$/size = ${alacritty_font_size}/m"
  rewrite_file "${config_home}/gtk-3.0/settings.ini" "s/^gtk-font-name=.*\$/gtk-font-name=JetBrains Mono ${gtk_font_size}/m"
  rewrite_file "${config_home}/gtk-4.0/settings.ini" "s/^gtk-font-name=.*\$/gtk-font-name=JetBrains Mono ${gtk_font_size}/m"
  rewrite_file "${config_home}/qt5ct/qt5ct.conf" "s/^fixed=.*\$/fixed=\"JetBrains Mono,${qt_font_size},-1,5,50,0,0,0,0,0,Regular\"/m; s/^general=.*\$/general=\"JetBrains Mono,${qt_font_size},-1,5,50,0,0,0,0,0,Regular\"/m"
  rewrite_file "${config_home}/qt6ct/qt6ct.conf" "s/^fixed=.*\$/fixed=\"JetBrains Mono,${qt_font_size},-1,5,50,0,0,0,0,0,Regular\"/m; s/^general=.*\$/general=\"JetBrains Mono,${qt_font_size},-1,5,50,0,0,0,0,0,Regular\"/m"
  rewrite_file "${config_home}/rofi/config.rasi" "s/font: \"JetBrains Mono Nerd Font [0-9]+\";/font: \"JetBrains Mono Nerd Font ${rofi_font_size}\";/m"
  rewrite_file "${config_home}/niri/waybar/style.css" "s/font-size:\\s*[0-9]+pt;/font-size: ${waybar_font_size};/m"
  rewrite_file "${config_home}/niri/waybar/config" "s/(\"network\":\\s*\\{.*?\"max-length\":\\s*)\\d+/\${1}${waybar_network_max_length}/s; s/(\"custom\\/playerctl\":\\s*\\{.*?\"max-length\":\\s*)\\d+/\${1}${waybar_playerctl_max_length}/s; s/(\"custom\\/playerctl\":\\s*\\{.*?\"min-length\":\\s*)\\d+/\${1}${waybar_playerctl_min_length}/s"
  rewrite_file "${config_home}/mako/config" "s/^font=.*/font=JetBrains Mono Nerd Font ${mako_font_size}/m; s/^width=.*/width=${mako_width}/m; s/^padding=.*/padding=${mako_padding}/m"
  rewrite_file "${config_home}/swaylock/config" "s/^indicator-radius=.*/indicator-radius=${swaylock_indicator_radius}/m; s/^indicator-thickness=.*/indicator-thickness=${swaylock_indicator_thickness}/m"
  rewrite_file "${config_home}/wlogout/style.css" "s/font-size:\\s*[0-9]+px;/font-size: ${wlogout_font_size};/m"
  rewrite_file "${config_home}/zathura/zathurarc" "s/set font\\s+\"JetBrainsMono Nerd Font [0-9]+\"/set font                    \"JetBrainsMono Nerd Font ${zathura_font_size}\"/m"

  if [[ -f /usr/share/sddm/themes/silent/configs/gruvbox.conf && -w /usr/share/sddm/themes/silent/configs/gruvbox.conf ]]; then
    rewrite_file /usr/share/sddm/themes/silent/configs/gruvbox.conf '
      s/^scale = .*$/'"scale = ${sddm_scale}"'/m;
      s/(\[LockScreen\.Clock\]\n(?:.*\n)*?font-size = )\d+/${1}'"${sddm_clock_font_size}"'/;
      s/(\[LockScreen\.Date\]\n(?:.*\n)*?font-size = )\d+/${1}'"${sddm_date_font_size}"'/;
      s/(\[LockScreen\.Message\]\n(?:.*\n)*?font-size = )\d+/${1}'"${sddm_message_font_size}"'/;
      s/(\[LoginScreen\.LoginArea\.Username\]\n(?:.*\n)*?font-size = )\d+/${1}'"${sddm_username_font_size}"'/;
      s/(\[LoginScreen\.LoginArea\.PasswordInput\]\n(?:.*\n)*?width = )\d+/${1}'"${sddm_password_width}"'/;
      s/(\[LoginScreen\.LoginArea\.PasswordInput\]\n(?:.*\n)*?height = )\d+/${1}'"${sddm_password_height}"'/;
      s/(\[LoginScreen\.LoginArea\.PasswordInput\]\n(?:.*\n)*?font-size = )\d+/${1}'"${sddm_password_font_size}"'/;
      s/(\[LoginScreen\.LoginArea\.LoginButton\]\n(?:.*\n)*?font-size = )\d+/${1}'"${sddm_button_font_size}"'/;
      s/(\[LoginScreen\.LoginArea\.Spinner\]\n(?:.*\n)*?font-size = )\d+/${1}'"${sddm_spinner_font_size}"'/;
      s/(\[LoginScreen\.LoginArea\.WarningMessage\]\n(?:.*\n)*?font-size = )\d+/${1}'"${sddm_warning_font_size}"'/;
      s/(\[LoginScreen\.MenuArea\.Buttons\]\n(?:.*\n)*?size = )\d+/${1}'"${sddm_menu_button_size}"'/;
      s/(\[LoginScreen\.MenuArea\.Popups\]\n(?:.*\n)*?font-size = )\d+/${1}'"${sddm_popup_font_size}"'/;
      s/(\[LoginScreen\.MenuArea\.Session\]\n(?:.*\n)*?button-width = )\d+/${1}'"${sddm_session_button_width}"'/;
      s/(\[LoginScreen\.MenuArea\.Session\]\n(?:.*\n)*?popup-width = )\d+/${1}'"${sddm_session_popup_width}"'/;
      s/(\[LoginScreen\.MenuArea\.Session\]\n(?:.*\n)*?font-size = )\d+/${1}'"${sddm_session_font_size}"'/;
      s/(\[LoginScreen\.MenuArea\.Layout\]\n(?:.*\n)*?popup-width = )\d+/${1}'"${sddm_layout_popup_width}"'/;
      s/(\[LoginScreen\.MenuArea\.Layout\]\n(?:.*\n)*?font-size = )\d+/${1}'"${sddm_layout_font_size}"'/;
      s/(\[LoginScreen\.VirtualKeyboard\]\n(?:.*\n)*?scale = )[^\n]+/${1}'"${sddm_virtual_keyboard_scale}"'/;
    '
  fi

  printf '%s\n' "${resolved}" > "${state_file}"

  if [[ -x "${HOME}/.local/bin/relaunch-waybar" ]]; then
    "${HOME}/.local/bin/relaunch-waybar" &
  fi

  if pgrep -x mako >/dev/null 2>&1; then
    pkill mako 2>/dev/null || true
    nohup mako >/dev/null 2>&1 &
  fi

  if command -v notify-send >/dev/null 2>&1; then
    notify-send "UI density" "Profile: ${resolved}" >/dev/null 2>&1 || true
  fi
}

case "${profile}" in
  auto)
    apply_profile "$(detect_auto_profile)"
    ;;
  tiny|compact|normal|large|huge)
    apply_profile "${profile}"
    ;;
  up)
    apply_profile "$(profile_up)"
    ;;
  down)
    apply_profile "$(profile_down)"
    ;;
  current)
    current_profile
    ;;
  *)
    printf 'Usage: %s [auto|tiny|compact|normal|large|huge|up|down|current]\n' "$0" >&2
    exit 1
    ;;
esac
